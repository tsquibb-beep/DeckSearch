// DeckSearch — settings. Reload in game with the dev console: dsearch reload
//
// Copy this file to your save folder to keep your settings through mod updates:
//   %APPDATA%\SlayTheSpire2\DeckSearch.config.jsonc
// That copy is read in preference to this one.
{
    // Master switch for the whole mod.
    "enabled": true,

    // Also match words in the card text ("exhaust", "block"), not just card names.
    "searchDescriptions": true,

    // How close a match has to be. Name matches score 100-120, card type or rarity 110, typos in a name 45-75,
    // words in the card text 50, typos in the card text 20-35. Raise to be stricter.
    "minScore": 30,

    // Pause after your last keystroke before the cards re-arrange, in milliseconds.
    "debounceMs": 200,

    // Also add the sort bar and search box to the screens that pick cards from your deck:
    // upgrade (campfire, events, relics), remove, transform and enchant.
    "pickScreens": true,

    // Put the cursor in the search box as soon as the Deck screen or a card picker opens.
    "focusOnOpen": false,

    // Keys that jump to the search box. Godot key names, modifiers joined with "+",
    // e.g. "Ctrl+F", "Slash", "Shift+S".
    "focusShortcuts": ["Ctrl+F"],

    // The box sits on the sort bar. Its width, and how narrow the sort buttons become to make
    // room (a button never gets narrower than its label). The game's own sizes are 250 and 50.
    "searchWidth": 340,
    "sortButtonWidth": 190,
    "sortButtonSpacing": 30
}
